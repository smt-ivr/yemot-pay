{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yemot-pay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yemot-pay",
      "database_id": "dd8bf73b-6dca-446d-a929-e467025ceac7"
    }
  ],
  // 06:00 UTC = 08:00/09:00 שעון ישראל
  "triggers": { "crons": ["0 6 * * *"] }
  // סודות (לא כאן!): wrangler secret put TENANT_KEYS
}
